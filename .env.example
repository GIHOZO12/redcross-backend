# =============================================================
#  TEMPLATE ONLY - THIS FILE IS COMMITTED TO GIT.
#  Do NOT put real values here. Put them in .env instead.
#  Every key below must stay blank.
# =============================================================
# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env
# In production set these as real environment variables on the host instead of
# shipping a .env file.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Required whenever DJANGO_DEBUG is off.
DJANGO_SECRET_KEY=

# Leave off (or unset) in production. Local development wants True.
DJANGO_DEBUG=False

# Comma-separated. Must include the deployed hostname.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,ismailg1.pythonanywhere.com


# --- Database (Supabase Postgres) -------------------------------------------
# Unset means "use the local db.sqlite3 file".
#
# Take the SESSION MODE POOLER string from the Supabase dashboard:
#   Project Settings -> Database -> Connection string -> Session pooler
# It looks like this - note port 5432 and the postgres.<ref> username:
#   postgresql://postgres.abcdefghijkl:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#
# Do NOT use:
#   db.<ref>.supabase.co:5432  -> IPv6 only without the paid IPv4 add-on
#   ...pooler.supabase.com:6543 -> transaction mode, breaks migrate
#
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F).
DATABASE_URL=

# Supabase requires TLS; leave this alone unless your Postgres has no TLS.
DATABASE_SSL_REQUIRE=True
# Seconds to keep a connection open between requests. 0 disables reuse.
DJANGO_CONN_MAX_AGE=60


# --- Media storage (Cloudflare R2) ------------------------------------------
# Unset R2_BUCKET_NAME to store uploads on the local disk instead.
# Create the bucket and an API token under R2 in the Cloudflare dashboard.
R2_BUCKET_NAME=
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public hostname for serving files: an R2 custom domain, or the bucket's
# r2.dev address if you enable public access. No scheme, no trailing slash.
# Leave blank and Django falls back to signed, expiring URLs.
R2_CUSTOM_DOMAIN=


# --- Email ------------------------------------------------------------------
# Leave EMAIL_HOST_USER blank and mail is printed to the console instead of
# being sent, which is usually what you want locally.
#
# The app password that was previously committed in settings.py must be
# revoked: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=


# --- Frontend origins -------------------------------------------------------
# Comma-separated. Add the deployed frontend URL before going live.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://ismailg1.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Defaults to the value of DJANGO_DEBUG. Never turn this on in production.
DJANGO_CORS_ALLOW_ALL_ORIGINS=False


# --- Optional overrides -----------------------------------------------------
# Cookie Secure flag; defaults to the opposite of DJANGO_DEBUG.
# DJANGO_COOKIE_SECURE=True
# Redirect HTTP to HTTPS; defaults to on when DJANGO_DEBUG is off.
# DJANGO_SECURE_SSL_REDIRECT=True
# HSTS is off by default because it is hard to reverse. Enable once HTTPS works.
# DJANGO_HSTS_SECONDS=31536000
# Who may read /api/docs/. Defaults to AllowAny in debug, IsAdminUser otherwise.
# DJANGO_DOCS_PERMISSIONS=rest_framework.permissions.AllowAny
